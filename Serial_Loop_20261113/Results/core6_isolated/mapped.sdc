###################################################################

# Created by write_sdc on Fri Nov 13 00:39:59 2026

###################################################################
set sdc_version 2.1

set_units -time ns -resistance kOhm -capacitance pF -voltage V -current mA
set_operating_conditions typical -library typical
set_wire_load_mode enclosed
set_driving_cell -lib_cell INVX1 -library typical [get_ports {IF[1]}]
set_driving_cell -lib_cell INVX1 -library typical [get_ports {IF[0]}]
set_driving_cell -lib_cell INVX1 -library typical [get_ports if_valid]
set_driving_cell -lib_cell INVX1 -library typical [get_ports cfg_valid]
set_driving_cell -lib_cell INVX1 -library typical [get_ports {cfg_channel[2]}]
set_driving_cell -lib_cell INVX1 -library typical [get_ports {cfg_channel[1]}]
set_driving_cell -lib_cell INVX1 -library typical [get_ports {cfg_channel[0]}]
set_driving_cell -lib_cell INVX1 -library typical [get_ports {cfg_prn[5]}]
set_driving_cell -lib_cell INVX1 -library typical [get_ports {cfg_prn[4]}]
set_driving_cell -lib_cell INVX1 -library typical [get_ports {cfg_prn[3]}]
set_driving_cell -lib_cell INVX1 -library typical [get_ports {cfg_prn[2]}]
set_driving_cell -lib_cell INVX1 -library typical [get_ports {cfg_prn[1]}]
set_driving_cell -lib_cell INVX1 -library typical [get_ports {cfg_prn[0]}]
set_driving_cell -lib_cell INVX1 -library typical [get_ports cfg_enable]
set_load -pin_load 0.006604 [get_ports if_ready]
set_load -pin_load 0.006604 [get_ports {capture_ok[5]}]
set_load -pin_load 0.006604 [get_ports {capture_ok[4]}]
set_load -pin_load 0.006604 [get_ports {capture_ok[3]}]
set_load -pin_load 0.006604 [get_ports {capture_ok[2]}]
set_load -pin_load 0.006604 [get_ports {capture_ok[1]}]
set_load -pin_load 0.006604 [get_ports {capture_ok[0]}]
set_load -pin_load 0.006604 [get_ports {bit_sync_ok[5]}]
set_load -pin_load 0.006604 [get_ports {bit_sync_ok[4]}]
set_load -pin_load 0.006604 [get_ports {bit_sync_ok[3]}]
set_load -pin_load 0.006604 [get_ports {bit_sync_ok[2]}]
set_load -pin_load 0.006604 [get_ports {bit_sync_ok[1]}]
set_load -pin_load 0.006604 [get_ports {bit_sync_ok[0]}]
set_load -pin_load 0.006604 [get_ports {nav_data[5]}]
set_load -pin_load 0.006604 [get_ports {nav_data[4]}]
set_load -pin_load 0.006604 [get_ports {nav_data[3]}]
set_load -pin_load 0.006604 [get_ports {nav_data[2]}]
set_load -pin_load 0.006604 [get_ports {nav_data[1]}]
set_load -pin_load 0.006604 [get_ports {nav_data[0]}]
set_load -pin_load 0.006604 [get_ports {nav_valid[5]}]
set_load -pin_load 0.006604 [get_ports {nav_valid[4]}]
set_load -pin_load 0.006604 [get_ports {nav_valid[3]}]
set_load -pin_load 0.006604 [get_ports {nav_valid[2]}]
set_load -pin_load 0.006604 [get_ports {nav_valid[1]}]
set_load -pin_load 0.006604 [get_ports {nav_valid[0]}]
create_clock [get_ports clk]  -period 10  -waveform {0 5}
set_clock_uncertainty 0.2  [get_clocks clk]
set_clock_transition -max -rise 0.1 [get_clocks clk]
set_clock_transition -max -fall 0.1 [get_clocks clk]
set_clock_transition -min -rise 0.1 [get_clocks clk]
set_clock_transition -min -fall 0.1 [get_clocks clk]
set_false_path   -from [get_ports rst_n]
set_input_delay -clock clk  -max 1  [get_ports {IF[1]}]
set_input_delay -clock clk  -min 0  [get_ports {IF[1]}]
set_input_delay -clock clk  -max 1  [get_ports {IF[0]}]
set_input_delay -clock clk  -min 0  [get_ports {IF[0]}]
set_input_delay -clock clk  -max 1  [get_ports if_valid]
set_input_delay -clock clk  -min 0  [get_ports if_valid]
set_input_delay -clock clk  -max 1  [get_ports cfg_valid]
set_input_delay -clock clk  -min 0  [get_ports cfg_valid]
set_input_delay -clock clk  -max 1  [get_ports {cfg_channel[2]}]
set_input_delay -clock clk  -min 0  [get_ports {cfg_channel[2]}]
set_input_delay -clock clk  -max 1  [get_ports {cfg_channel[1]}]
set_input_delay -clock clk  -min 0  [get_ports {cfg_channel[1]}]
set_input_delay -clock clk  -max 1  [get_ports {cfg_channel[0]}]
set_input_delay -clock clk  -min 0  [get_ports {cfg_channel[0]}]
set_input_delay -clock clk  -max 1  [get_ports {cfg_prn[5]}]
set_input_delay -clock clk  -min 0  [get_ports {cfg_prn[5]}]
set_input_delay -clock clk  -max 1  [get_ports {cfg_prn[4]}]
set_input_delay -clock clk  -min 0  [get_ports {cfg_prn[4]}]
set_input_delay -clock clk  -max 1  [get_ports {cfg_prn[3]}]
set_input_delay -clock clk  -min 0  [get_ports {cfg_prn[3]}]
set_input_delay -clock clk  -max 1  [get_ports {cfg_prn[2]}]
set_input_delay -clock clk  -min 0  [get_ports {cfg_prn[2]}]
set_input_delay -clock clk  -max 1  [get_ports {cfg_prn[1]}]
set_input_delay -clock clk  -min 0  [get_ports {cfg_prn[1]}]
set_input_delay -clock clk  -max 1  [get_ports {cfg_prn[0]}]
set_input_delay -clock clk  -min 0  [get_ports {cfg_prn[0]}]
set_input_delay -clock clk  -max 1  [get_ports cfg_enable]
set_input_delay -clock clk  -min 0  [get_ports cfg_enable]
set_output_delay -clock clk  -max 1  [get_ports if_ready]
set_output_delay -clock clk  -min 0  [get_ports if_ready]
set_output_delay -clock clk  -max 1  [get_ports {capture_ok[5]}]
set_output_delay -clock clk  -min 0  [get_ports {capture_ok[5]}]
set_output_delay -clock clk  -max 1  [get_ports {capture_ok[4]}]
set_output_delay -clock clk  -min 0  [get_ports {capture_ok[4]}]
set_output_delay -clock clk  -max 1  [get_ports {capture_ok[3]}]
set_output_delay -clock clk  -min 0  [get_ports {capture_ok[3]}]
set_output_delay -clock clk  -max 1  [get_ports {capture_ok[2]}]
set_output_delay -clock clk  -min 0  [get_ports {capture_ok[2]}]
set_output_delay -clock clk  -max 1  [get_ports {capture_ok[1]}]
set_output_delay -clock clk  -min 0  [get_ports {capture_ok[1]}]
set_output_delay -clock clk  -max 1  [get_ports {capture_ok[0]}]
set_output_delay -clock clk  -min 0  [get_ports {capture_ok[0]}]
set_output_delay -clock clk  -max 1  [get_ports {bit_sync_ok[5]}]
set_output_delay -clock clk  -min 0  [get_ports {bit_sync_ok[5]}]
set_output_delay -clock clk  -max 1  [get_ports {bit_sync_ok[4]}]
set_output_delay -clock clk  -min 0  [get_ports {bit_sync_ok[4]}]
set_output_delay -clock clk  -max 1  [get_ports {bit_sync_ok[3]}]
set_output_delay -clock clk  -min 0  [get_ports {bit_sync_ok[3]}]
set_output_delay -clock clk  -max 1  [get_ports {bit_sync_ok[2]}]
set_output_delay -clock clk  -min 0  [get_ports {bit_sync_ok[2]}]
set_output_delay -clock clk  -max 1  [get_ports {bit_sync_ok[1]}]
set_output_delay -clock clk  -min 0  [get_ports {bit_sync_ok[1]}]
set_output_delay -clock clk  -max 1  [get_ports {bit_sync_ok[0]}]
set_output_delay -clock clk  -min 0  [get_ports {bit_sync_ok[0]}]
set_output_delay -clock clk  -max 1  [get_ports {nav_data[5]}]
set_output_delay -clock clk  -min 0  [get_ports {nav_data[5]}]
