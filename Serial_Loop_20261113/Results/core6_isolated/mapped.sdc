set_output_delay -clock clk  -max 1  [get_ports {nav_valid[4]}]
set_output_delay -clock clk  -min 0  [get_ports {nav_valid[4]}]
set_output_delay -clock clk  -max 1  [get_ports {nav_valid[3]}]
set_output_delay -clock clk  -min 0  [get_ports {nav_valid[3]}]
