set_output_delay -clock clk  -min 0  [get_ports {nav_data[3]}]
set_output_delay -clock clk  -max 1  [get_ports {nav_data[2]}]
set_output_delay -clock clk  -min 0  [get_ports {nav_data[2]}]
set_output_delay -clock clk  -max 1  [get_ports {nav_data[1]}]
set_output_delay -clock clk  -min 0  [get_ports {nav_data[1]}]
set_output_delay -clock clk  -max 1  [get_ports {nav_data[0]}]
set_output_delay -clock clk  -min 0  [get_ports {nav_data[0]}]
set_output_delay -clock clk  -max 1  [get_ports {nav_valid[5]}]
