###################################################################

# Created by write_sdc on Fri Oct 16 15:16:41 2026

###################################################################
set sdc_version 2.0

set_units -time ns -resistance MOhm -capacitance fF -voltage V -current uA
set_driving_cell -lib_cell INVX1 [get_ports load]
set_driving_cell -lib_cell INVX1 [get_ports chip_enable]
set_driving_cell -lib_cell INVX1 [get_ports {prn_select[5]}]
set_driving_cell -lib_cell INVX1 [get_ports {prn_select[4]}]
set_driving_cell -lib_cell INVX1 [get_ports {prn_select[3]}]
set_driving_cell -lib_cell INVX1 [get_ports {prn_select[2]}]
set_driving_cell -lib_cell INVX1 [get_ports {prn_select[1]}]
set_driving_cell -lib_cell INVX1 [get_ports {prn_select[0]}]
set_load -pin_load 14.0853 [get_ports chip]
set_load -pin_load 14.0853 [get_ports {chip_index[10]}]
set_load -pin_load 14.0853 [get_ports {chip_index[9]}]
set_load -pin_load 14.0853 [get_ports {chip_index[8]}]
set_load -pin_load 14.0853 [get_ports {chip_index[7]}]
set_load -pin_load 14.0853 [get_ports {chip_index[6]}]
set_load -pin_load 14.0853 [get_ports {chip_index[5]}]
set_load -pin_load 14.0853 [get_ports {chip_index[4]}]
set_load -pin_load 14.0853 [get_ports {chip_index[3]}]
set_load -pin_load 14.0853 [get_ports {chip_index[2]}]
set_load -pin_load 14.0853 [get_ports {chip_index[1]}]
set_load -pin_load 14.0853 [get_ports {chip_index[0]}]
set_load -pin_load 14.0853 [get_ports configured]
set_load -pin_load 14.0853 [get_ports epoch]
create_clock [get_ports clk]  -period 10  -waveform {0 5}
set_clock_uncertainty 0.2  [get_clocks clk]
set_false_path   -from [get_ports rst_n]
set_input_delay -clock clk  1  [get_ports load]
set_input_delay -clock clk  1  [get_ports chip_enable]
set_input_delay -clock clk  1  [get_ports {prn_select[5]}]
set_input_delay -clock clk  1  [get_ports {prn_select[4]}]
set_input_delay -clock clk  1  [get_ports {prn_select[3]}]
set_input_delay -clock clk  1  [get_ports {prn_select[2]}]
set_input_delay -clock clk  1  [get_ports {prn_select[1]}]
set_input_delay -clock clk  1  [get_ports {prn_select[0]}]
set_output_delay -clock clk  1  [get_ports chip]
set_output_delay -clock clk  1  [get_ports {chip_index[10]}]
set_output_delay -clock clk  1  [get_ports {chip_index[9]}]
set_output_delay -clock clk  1  [get_ports {chip_index[8]}]
set_output_delay -clock clk  1  [get_ports {chip_index[7]}]
set_output_delay -clock clk  1  [get_ports {chip_index[6]}]
set_output_delay -clock clk  1  [get_ports {chip_index[5]}]
set_output_delay -clock clk  1  [get_ports {chip_index[4]}]
set_output_delay -clock clk  1  [get_ports {chip_index[3]}]
set_output_delay -clock clk  1  [get_ports {chip_index[2]}]
set_output_delay -clock clk  1  [get_ports {chip_index[1]}]
set_output_delay -clock clk  1  [get_ports {chip_index[0]}]
set_output_delay -clock clk  1  [get_ports configured]
set_output_delay -clock clk  1  [get_ports epoch]
