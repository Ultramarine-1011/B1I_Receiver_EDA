source $env(EXPERIMENT_ROOT)/scripts/reports.tcl
if {$stage == "preflight"} {
    redirect $report_dir/libraries.rpt {list_libs}
    foreach name [list $env(STD_TT_LIB) $env(STD_SS_LIB) $env(STD_FF_LIB)] {
        if {[sizeof_collection [get_libs $name]] != 1} {error "Standard library name mismatch: $name"}
    }
    if {$env(LOCAL_PROBE) == 0} {
        foreach name [list $env(PAD_TT_LIB) $env(PAD_SS_LIB) $env(PAD_FF_LIB)] {
            foreach cell {PDDW08DGZ_H_G PDUW08DGZ_H_G PVDD1DGZ_H_G PVSS1DGZ_H_G PVDD2POC_H_G} {
                if {[sizeof_collection [get_lib_cells $name/$cell]] != 1} {error "PAD cell missing: $name/$cell"}
            }
        }
    }
    puts "LAB_PREFLIGHT_DC_PASS"
    exit 0
}
if {$stage == "synth"} {
    define_design_lib WORK -path ./WORK
    set rtl $env(REPO_ROOT)/student_release/student_release/rtl
    set_app_var search_path [concat [list $rtl $env(REPO_ROOT)] $search_path]
    if {$env(LOCAL_PROBE) == 1} {
        if {![analyze -format sverilog -define SYNTHESIS $env(LAB_DIR)/smoke.sv] || ![elaborate backend_smoke]} {exit 1}
    } else {
        set filelist [open $env(EXPERIMENT_ROOT)/work/stage/filelists/B1.txt r]
        foreach path [split [string trim [read $filelist]] \n] {
            set path [string trim $path]
            if {[string match *acquisition_pcps_blackbox.sv $path]} {
                if {$env(SYNTH_MODE) == "full"} {continue}
                set path $env(REPO_ROOT)/synth/m2_isolate/acquisition_pcps_blackbox.sv
            } elseif {$path == "rtl/tracking_channel_minimal.sv"} {
                set path $env(EXPERIMENT_ROOT)/work/stage/rtl/tracking_channel_minimal.sv
            } else {
                set path $rtl/[file tail $path]
            }
            if {![analyze -format sverilog -define SYNTHESIS $path]} {exit 1}
        }
        close $filelist
        if {$env(SYNTH_MODE) == "full"} {
            set filelist [open $env(PCPS_IMPL_F) r]
            foreach path [split [string trim [read $filelist]] \n] {
                set path [string trim $path]
                if {$path ne "" && ![string match {#*} $path]} {
                    if {![analyze -format sverilog -define SYNTHESIS $path]} {exit 1}
                }
            }
            close $filelist
        }
        if {![analyze -format sverilog $env(REPO_ROOT)/rtl/bds_bb_6ch_pad_top.sv]} {exit 1}
        if {![elaborate $env(TOP)] || ![link]} {exit 1}
        set top_design [get_object_name [current_design]]
        # Re-elaborate and map V6 arithmetic in the selected TSMC28 libraries.
        # No external arithmetic DDC is ever read in this flow.
        foreach name {tracking_atan tracking_divide_aid tracking_divide_step tracking_ratio_code tracking_ratio_phase} {
            current_design $name
            apply_corners
            set period 4
            if {$name == "tracking_atan" || $name == "tracking_ratio_code"} {set period $env(CLOCK_NS)}
            create_clock -name module_clk -period $period
            set_clock_uncertainty $env(UNCERTAINTY_NS) [get_clocks module_clk]
            set_input_delay -clock module_clk -max 0 [all_inputs]
            set_input_delay -clock module_clk -min 0 [all_inputs]
            set_output_delay -clock module_clk -max 0 [all_outputs]
            set_output_delay -clock module_clk -min 0 [all_outputs]
            set_driving_cell -library $env(STD_SS_LIB) -lib_cell $env(BLOCK_DRIVE_CELL) [all_inputs]
            set_load [expr {4 * [load_of $env(STD_SS_LIB)/$env(BLOCK_DRIVE_CELL)/$env(BLOCK_DRIVE_PIN)]}] [all_outputs]
            if {![compile -map_effort medium]} {exit 1}
            ungroup -all -flatten
            reset_design
            set_dont_touch [current_design] true
        }
        current_design $top_design
        if {![link]} {exit 1}
        set arithmetic [get_cells -hier -filter {ref_name =~ tracking_ratio_* || ref_name =~ tracking_atan* || ref_name =~ tracking_divide_*}]
        if {[sizeof_collection $arithmetic] != 42} {error "Expected 42 arithmetic instances for six channels"}
        set_dont_touch $arithmetic true
        set_boundary_optimization $arithmetic false
        set pads [get_cells -hier -filter {ref_name =~ PD* || ref_name =~ PV*}]
        set_dont_touch $pads true
        set_dont_use [get_lib_cells $env(PAD_SS_LIB)/*]
        if {$env(SYNTH_MODE) == "isolated"} {
            set acq [get_cells core/acquisition]
            set_dont_touch $acq true
            set_boundary_optimization $acq false
            puts "LAB_PCPS_ISOLATED_STORAGE_NOT_SYNTHESIZED"
        }
    }
    if {![link]} {exit 1}
    apply_corners
    if {$env(LOCAL_PROBE) == 1} {
        create_clock -name clk -period $env(CLOCK_NS) [get_ports clk]
        # The smoke TB drives these signals 0.01 ns after the falling edge.
        set_input_delay -clock clk -clock_fall -max 0.01 [get_ports {reset_n enable}]
        set_input_delay -clock clk -clock_fall -min 0.01 [get_ports {reset_n enable}]
        set_output_delay -clock clk -max 1 [all_outputs]
        set_output_delay -clock clk -min 0 [all_outputs]
        set_input_transition 0.1 [get_ports {reset_n enable}]
        set_load 0.01 [all_outputs]
    } else {source $env(LAB_DIR)/pad.sdc}
    redirect $report_dir/check_pre.rpt {check_design}
    if {![compile -map_effort medium]} {exit 1}
    change_names -rules verilog -hierarchy
    write -format verilog -hierarchy -output output/final.v
    write -format ddc -hierarchy -output output/final.ddc
    write_sdc output/final.sdc
    backend_reports ""
    puts "LAB_SYNTH_EXPORTED"
    exit 0
}
