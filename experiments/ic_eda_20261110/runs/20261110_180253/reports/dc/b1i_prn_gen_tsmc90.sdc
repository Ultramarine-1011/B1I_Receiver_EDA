###################################################################

# Created by write_sdc on Tue Nov 10 18:02:56 2026

###################################################################
set sdc_version 2.1

set_units -time ns -resistance kOhm -capacitance pF -voltage V -current mA
set_operating_conditions typical -library typical
set_wire_load_mode enclosed
set_driving_cell -lib_cell INVX1 -library typical [get_ports load]
set_driving_cell -lib_cell INVX1 -library typical [get_ports chip_enable]
set_driving_cell -lib_cell INVX1 -library typical [get_ports {prn_select[5]}]
set_driving_cell -lib_cell INVX1 -library typical [get_ports {prn_select[4]}]
set_driving_cell -lib_cell INVX1 -library typical [get_ports {prn_select[3]}]
set_driving_cell -lib_cell INVX1 -library typical [get_ports {prn_select[2]}]
set_driving_cell -lib_cell INVX1 -library typical [get_ports {prn_select[1]}]
set_driving_cell -lib_cell INVX1 -library typical [get_ports {prn_select[0]}]
set_load -pin_load 0.006604 [get_ports chip]
set_load -pin_load 0.006604 [get_ports {chip_index[10]}]
set_load -pin_load 0.006604 [get_ports {chip_index[9]}]
set_load -pin_load 0.006604 [get_ports {chip_index[8]}]
set_load -pin_load 0.006604 [get_ports {chip_index[7]}]
set_load -pin_load 0.006604 [get_ports {chip_index[6]}]
set_load -pin_load 0.006604 [get_ports {chip_index[5]}]
set_load -pin_load 0.006604 [get_ports {chip_index[4]}]
set_load -pin_load 0.006604 [get_ports {chip_index[3]}]
set_load -pin_load 0.006604 [get_ports {chip_index[2]}]
set_load -pin_load 0.006604 [get_ports {chip_index[1]}]
set_load -pin_load 0.006604 [get_ports {chip_index[0]}]
set_load -pin_load 0.006604 [get_ports configured]
set_load -pin_load 0.006604 [get_ports epoch]
create_clock [get_ports clk]  -period 10  -waveform {0 5}
set_clock_uncertainty 0.2  [get_clocks clk]
set_clock_transition -max -rise 0.1 [get_clocks clk]
set_clock_transition -max -fall 0.1 [get_clocks clk]
set_clock_transition -min -rise 0.1 [get_clocks clk]
set_clock_transition -min -fall 0.1 [get_clocks clk]
set_false_path   -from [get_ports rst_n]
set_input_delay -clock clk  -max 1  [get_ports load]
set_input_delay -clock clk  -min 0  [get_ports load]
set_input_delay -clock clk  -max 1  [get_ports chip_enable]
set_input_delay -clock clk  -min 0  [get_ports chip_enable]
set_input_delay -clock clk  -max 1  [get_ports {prn_select[5]}]
set_input_delay -clock clk  -min 0  [get_ports {prn_select[5]}]
set_input_delay -clock clk  -max 1  [get_ports {prn_select[4]}]
set_input_delay -clock clk  -min 0  [get_ports {prn_select[4]}]
set_input_delay -clock clk  -max 1  [get_ports {prn_select[3]}]
set_input_delay -clock clk  -min 0  [get_ports {prn_select[3]}]
set_input_delay -clock clk  -max 1  [get_ports {prn_select[2]}]
set_input_delay -clock clk  -min 0  [get_ports {prn_select[2]}]
set_input_delay -clock clk  -max 1  [get_ports {prn_select[1]}]
set_input_delay -clock clk  -min 0  [get_ports {prn_select[1]}]
set_input_delay -clock clk  -max 1  [get_ports {prn_select[0]}]
set_input_delay -clock clk  -min 0  [get_ports {prn_select[0]}]
set_output_delay -clock clk  -max 1  [get_ports chip]
set_output_delay -clock clk  -min 0  [get_ports chip]
set_output_delay -clock clk  -max 1  [get_ports {chip_index[10]}]
set_output_delay -clock clk  -min 0  [get_ports {chip_index[10]}]
set_output_delay -clock clk  -max 1  [get_ports {chip_index[9]}]
set_output_delay -clock clk  -min 0  [get_ports {chip_index[9]}]
set_output_delay -clock clk  -max 1  [get_ports {chip_index[8]}]
set_output_delay -clock clk  -min 0  [get_ports {chip_index[8]}]
set_output_delay -clock clk  -max 1  [get_ports {chip_index[7]}]
set_output_delay -clock clk  -min 0  [get_ports {chip_index[7]}]
set_output_delay -clock clk  -max 1  [get_ports {chip_index[6]}]
set_output_delay -clock clk  -min 0  [get_ports {chip_index[6]}]
set_output_delay -clock clk  -max 1  [get_ports {chip_index[5]}]
set_output_delay -clock clk  -min 0  [get_ports {chip_index[5]}]
set_output_delay -clock clk  -max 1  [get_ports {chip_index[4]}]
set_output_delay -clock clk  -min 0  [get_ports {chip_index[4]}]
set_output_delay -clock clk  -max 1  [get_ports {chip_index[3]}]
set_output_delay -clock clk  -min 0  [get_ports {chip_index[3]}]
set_output_delay -clock clk  -max 1  [get_ports {chip_index[2]}]
set_output_delay -clock clk  -min 0  [get_ports {chip_index[2]}]
set_output_delay -clock clk  -max 1  [get_ports {chip_index[1]}]
set_output_delay -clock clk  -min 0  [get_ports {chip_index[1]}]
set_output_delay -clock clk  -max 1  [get_ports {chip_index[0]}]
set_output_delay -clock clk  -min 0  [get_ports {chip_index[0]}]
set_output_delay -clock clk  -max 1  [get_ports configured]
set_output_delay -clock clk  -min 0  [get_ports configured]
set_output_delay -clock clk  -max 1  [get_ports epoch]
set_output_delay -clock clk  -min 0  [get_ports epoch]
